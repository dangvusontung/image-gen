# Copy to .env at the repo root. Backend reads it on startup; nothing here is exposed to the browser.
# Note: real environment variables take precedence over this file.

# Storage (defaults: <repo>/data, <repo>/data/assets, <repo>/data/image_gen.db)
# DATA_DIR=./data
# ASSETS_DIR=./data/assets
# DATABASE_URL=sqlite:///./data/image_gen.db

# Max bytes per uploaded photo (20 MB)
UPLOAD_MAX_SIZE=20971520

# Server binds to loopback by default; only change if you understand the exposure.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Providers. Leave empty to use the mock provider only.
GEMINI_API_KEY=
BFL_API_KEY=
# BFL region: https://api.bfl.ai (global) | https://api.eu.bfl.ai | https://api.us.bfl.ai
BFL_API_BASE=https://api.bfl.ai
# How reference images are inlined for BFL: base64 | data_url (unverified for FLUX.2; switch if BFL returns 422)
BFL_IMAGE_ENCODING=base64

# Jobs
JOB_CONCURRENCY=3
JOB_MAX_ATTEMPTS=3
JOB_POLL_TIMEOUT_SECONDS=600
# Rolling 24h cap on estimated/actual spend for paid providers (USD)
SPEND_LIMIT_USD_PER_DAY=5
# Mock provider latency, to make progress states visible
MOCK_DELAY_SECONDS=1.5

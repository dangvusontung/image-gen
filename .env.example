# Copy to .env at the repo root. Backend reads it on startup; nothing here is exposed to the browser.
# Note: real environment variables take precedence over this file.

# Storage (defaults: <repo>/data, <repo>/data/assets, <repo>/data/image_gen.db)
# DATA_DIR=./data
# ASSETS_DIR=./data/assets
# DATABASE_URL=sqlite:///./data/image_gen.db

# Max bytes per uploaded photo (20 MB)
UPLOAD_MAX_SIZE=20971520

# Server binds to loopback by default; only change if you understand the exposure.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Providers. Leave empty to use the mock provider only.
GEMINI_API_KEY=
BFL_API_KEY=
# BFL region: https://api.bfl.ai (global) | https://api.eu.bfl.ai | https://api.us.bfl.ai
BFL_API_BASE=https://api.bfl.ai
# How reference images are inlined for BFL: base64 | data_url (unverified for FLUX.2; switch if BFL returns 422)
BFL_IMAGE_ENCODING=base64

# BytePlus ModelArk (Seedream). Region base URLs:
#   https://ark.ap-southeast.bytepluses.com/api/v3 | https://ark.eu-west.bytepluses.com/api/v3
ARK_API_KEY=
ARK_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3
# ModelArk does not publish per-image prices. Leave 0 and cost estimates show "unknown";
# set your contract price to include these jobs in SPEND_LIMIT_USD_PER_DAY.
ARK_PRICE_PER_IMAGE_USD=0
# 1 to let the provider add its watermark; 0 (default) requests watermark=false
ARK_WATERMARK=0
# Optional: control-plane credentials (a signed AccessKey/SecretKey pair, NOT the Bearer key
# above). With these the model list comes from your account's real catalogue via
# Action=ListFoundationModels; without them the adapter uses its built-in list.
ARK_ACCESS_KEY=
ARK_SECRET_KEY=
ARK_CONTROL_HOST=open.byteplusapi.com
# Must match your ARK_API_BASE region: ap-southeast-1 | eu-west-1
ARK_REGION=ap-southeast-1

# OpenAI GPT Image
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# low | medium | high | auto
OPENAI_IMAGE_QUALITY=high
# GPT Image is priced per token and varies by quality; set your own figure to include these
# jobs in SPEND_LIMIT_USD_PER_DAY. 0 means cost estimates show "unknown".
OPENAI_PRICE_PER_IMAGE_USD=0

# Jobs
JOB_CONCURRENCY=9
JOB_MAX_ATTEMPTS=3
JOB_POLL_TIMEOUT_SECONDS=600
# Optional rolling 24h app spending cap in USD; 0 means unlimited
SPEND_LIMIT_USD_PER_DAY=0
# Mock provider latency, to make progress states visible
MOCK_DELAY_SECONDS=1.5
